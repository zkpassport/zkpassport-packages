//! The checks `outer_count_{N+3}` makes on its subproofs (circuits 0.23.0,
//! src/noir/bin/main/outer/count_*/src/main.nr, generated by src/ts/scripts/circuit-builder.ts),
//! as one function generic over the number of disclosure proofs `N`. Same checks, same order and
//! same messages, so a diff against the generated circuit stays readable.
use crate::types::{OuterPublicInputs, Subproofs};
use poseidon::poseidon2::Poseidon2;

global PROOF_TYPE_HONK_ZK: u32 = 6;

// utils::constants of the circuits repo
global NON_SALTED_MOCK_NULLIFIER: Field = 2;
global SALTED_NULLIFIER: Field = 1;
global SALTED_MOCK_NULLIFIER: Field = 3;
global NONE_NULLIFIER: Field = 4;

// commitment/common's compute_merkle_root
fn compute_merkle_root<let D: u32>(leaf: Field, index: Field, hash_path: [Field; D]) -> Field {
    let index_bits: [bool; D] = index.to_le_bits();
    let mut current = leaf;
    for i in 0..D {
        let path_bit = index_bits[i];
        let (hash_left, hash_right) = if path_bit {
            (hash_path[i], current)
        } else {
            (current, hash_path[i])
        };
        current = Poseidon2::hash([hash_left, hash_right], 2);
    }
    current
}

fn poseidon2_hash<let L: u32>(input: [Field; L]) -> Field {
    Poseidon2::hash(input, L)
}

/// Verifies the subproofs recursively and constrains `subproofs.public_inputs` as the outer circuit
/// constrains its own public inputs. Unlike the outer circuit, key hashes are computed from the
/// vkeys rather than taken as witnesses and checked against them.
pub fn verify_subproofs<let N: u32>(subproofs: Subproofs<N>) {
    let OuterPublicInputs {
        certificate_registry_root,
        circuit_registry_root,
        current_date,
        service_scope,
        service_subscope,
        param_commitments,
        nullifier_type,
        scoped_nullifier,
        oprf_pk_hash,
        verification_method,
    } = subproofs.public_inputs;
    let csc_to_dsc_proof = subproofs.csc_to_dsc_proof;
    let dsc_to_id_data_proof = subproofs.dsc_to_id_data_proof;
    let integrity_check_proof = subproofs.integrity_check_proof;
    let disclosure_proofs = subproofs.disclosure_proofs;

    let csc_to_dsc_key_hash = poseidon2_hash(csc_to_dsc_proof.vkey);
    let dsc_to_id_data_key_hash = poseidon2_hash(dsc_to_id_data_proof.vkey);
    let integrity_check_key_hash = poseidon2_hash(integrity_check_proof.vkey);
    let mut disclosure_key_hashes = [0; N];
    for i in 0..N {
        disclosure_key_hashes[i] = poseidon2_hash(disclosure_proofs[i].vkey);
    }

    // Verify that all subproofs vkey hashes exist in the circuit tree
    assert_eq(
        circuit_registry_root,
        compute_merkle_root(
            csc_to_dsc_key_hash,
            csc_to_dsc_proof.tree_index,
            csc_to_dsc_proof.tree_hash_path,
        ),
        "CSC to DSC proof vkey hash not found in circuit tree",
    );
    assert_eq(
        circuit_registry_root,
        compute_merkle_root(
            dsc_to_id_data_key_hash,
            dsc_to_id_data_proof.tree_index,
            dsc_to_id_data_proof.tree_hash_path,
        ),
        "DSC to ID Data proof vkey hash not found in circuit tree",
    );
    assert_eq(
        circuit_registry_root,
        compute_merkle_root(
            integrity_check_key_hash,
            integrity_check_proof.tree_index,
            integrity_check_proof.tree_hash_path,
        ),
        "Integrity check proof vkey hash not found in circuit tree",
    );
    for i in 0..N {
        assert_eq(
            circuit_registry_root,
            compute_merkle_root(
                disclosure_key_hashes[i],
                disclosure_proofs[i].tree_index,
                disclosure_proofs[i].tree_hash_path,
            ),
            "Disclosure proof vkey hash not found in circuit tree",
        );
    }

    // Only NONE proofs (or NON_SALTED_MOCK for ZKR IDs) may have a zero scoped nullifier
    assert(
        (scoped_nullifier != 0)
            | (nullifier_type == NONE_NULLIFIER)
            | (nullifier_type == NON_SALTED_MOCK_NULLIFIER),
        "Scoped nullifier must be non-zero unless the nullifier type is NONE",
    );
    assert(
        (scoped_nullifier == 0) | (nullifier_type != NONE_NULLIFIER),
        "Scoped nullifier must be zero when the nullifier type is NONE",
    );
    // oprf_pk_hash is only meaningful for salted nullifiers
    assert(
        (nullifier_type == SALTED_NULLIFIER)
            | (nullifier_type == SALTED_MOCK_NULLIFIER)
            | (oprf_pk_hash == 0),
        "oprf_pk_hash must be zero unless the nullifier is salted",
    );

    std::verify_proof_with_type(
        csc_to_dsc_proof.vkey,
        csc_to_dsc_proof.proof,
        [
            certificate_registry_root,
            csc_to_dsc_proof.public_inputs[0], // comm_out
        ],
        csc_to_dsc_key_hash,
        PROOF_TYPE_HONK_ZK,
    );

    assert_eq(
        csc_to_dsc_proof.public_inputs[0],
        dsc_to_id_data_proof.public_inputs[0],
        "Commitment out from CSC to DSC circuit != commitment in from DSC to ID Data circuit",
    );

    std::verify_proof_with_type(
        dsc_to_id_data_proof.vkey,
        dsc_to_id_data_proof.proof,
        [
            dsc_to_id_data_proof.public_inputs[0], // comm_in
            dsc_to_id_data_proof.public_inputs[1], // comm_out
        ],
        dsc_to_id_data_key_hash,
        PROOF_TYPE_HONK_ZK,
    );

    assert_eq(
        dsc_to_id_data_proof.public_inputs[1],
        integrity_check_proof.public_inputs[0],
        "Commitment out from DSC to ID Data circuit != commitment in from integrity check circuit",
    );

    std::verify_proof_with_type(
        integrity_check_proof.vkey,
        integrity_check_proof.proof,
        [
            integrity_check_proof.public_inputs[0], // comm_in
            integrity_check_proof.public_inputs[1], // comm_out
            integrity_check_proof.public_inputs[2], // verification_method
        ],
        integrity_check_key_hash,
        PROOF_TYPE_HONK_ZK,
    );

    assert_eq(
        integrity_check_proof.public_inputs[2],
        verification_method,
        "Verification method from integrity check circuit != expected verification method",
    );

    let mut found_valid_scoped_nullifier = false;

    for i in 0..N {
        assert_eq(
            integrity_check_proof.public_inputs[1],
            disclosure_proofs[i].public_inputs[0],
            "Commitment out from integrity check circuit != commitment in from disclosure circuit",
        );
        // Each disclosure subproof either does not participate (0, or NONE for the type) or agrees
        // with the top-level value, for scoped_nullifier, nullifier_type and oprf_pk_hash.
        assert(
            (disclosure_proofs[i].public_inputs[1] == 0)
                | (disclosure_proofs[i].public_inputs[1] == scoped_nullifier),
            "Disclosure proof scoped nullifier must be either 0 or the expected scoped nullifier",
        );
        assert(
            (disclosure_proofs[i].public_inputs[2] == NONE_NULLIFIER)
                | (disclosure_proofs[i].public_inputs[2] == nullifier_type),
            "Disclosure proof nullifier type must be either NONE or the expected nullifier type",
        );
        assert(
            (disclosure_proofs[i].public_inputs[3] == 0)
                | (disclosure_proofs[i].public_inputs[3] == oprf_pk_hash),
            "Disclosure proof oprf_pk_hash must be either 0 or the expected oprf_pk_hash",
        );
        if (
            !found_valid_scoped_nullifier
                & (disclosure_proofs[i].public_inputs[1] == scoped_nullifier)
        ) {
            found_valid_scoped_nullifier = true;
        }

        std::verify_proof_with_type(
            disclosure_proofs[i].vkey,
            disclosure_proofs[i].proof,
            [
                disclosure_proofs[i].public_inputs[0], // comm_in
                current_date as Field,
                service_scope,
                service_subscope,
                param_commitments[i],
                disclosure_proofs[i].public_inputs[2], // nullifier_type
                disclosure_proofs[i].public_inputs[1], // scoped_nullifier
                disclosure_proofs[i].public_inputs[3], // oprf_pk_hash
            ],
            disclosure_key_hashes[i],
            PROOF_TYPE_HONK_ZK,
        );
    }

    assert(found_valid_scoped_nullifier, "Incorrect scoped nullifier provided");
}

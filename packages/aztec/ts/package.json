{
  "name": "@zkpassport/aztec",
  "version": "0.1.0-beta.0",
  "description": "TS companion for the ZKPassport Aztec verifier library: the registry artifact and its PXE registration, proof, disclose and sanctions capsule assembly, and disclosed-data parsing",
  "author": "ZKPassport",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zkpassport/zkpassport-packages",
    "directory": "packages/aztec/ts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test test",
    "check": "prettier -c src test scripts && eslint src test scripts --ext .ts",
    "format": "prettier -c -w src test scripts",
    "validate-package": "../../../scripts/validate-package.sh --ignore-rules cjs-resolves-to-esm",
    "prepublishOnly": "../../../scripts/prepublish.sh"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "zkpassport",
    "aztec",
    "noir",
    "zero-knowledge"
  ],
  "dependencies": {
    "@zkpassport/utils": "workspace:*"
  },
  "peerDependencies": {
    "@aztec-labs/aztec.js": "6.0.x",
    "@aztec-labs/stdlib": "6.0.x"
  },
  "devDependencies": {
    "@aztec-labs/accounts": "6.0.0",
    "@aztec-labs/aztec.js": "6.0.0",
    "@aztec-labs/stdlib": "6.0.0"
  },
  "packageManager": "bun@1.3.1"
}

{
  "name": "@zkpassport/sanctions",
  "version": "0.1.0",
  "description": "Builds the ZKPassport sanctions tree: OpenSanctions (FollowTheMoney) parsing, ICAO 9303 MRZ formatting and transliteration, Poseidon2 leaves and the ordered Merkle tree",
  "author": "ZKPassport",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zkpassport/zkpassport-packages",
    "directory": "packages/sanctions"
  },
  "type": "module",
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev:build": "DEV_BUILD=true bun run build",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "check": "prettier -c src && eslint src --ext .ts",
    "format": "prettier -c -w src && eslint src --ext .ts --fix",
    "validate-package": "../../scripts/validate-package.sh",
    "prepublishOnly": "../../scripts/prepublish.sh"
  },
  "files": [
    "dist/esm",
    "dist/cjs"
  ],
  "keywords": [
    "zkpassport",
    "sanctions",
    "opensanctions",
    "followthemoney",
    "mrz",
    "icao 9303"
  ],
  "dependencies": {
    "@zkpassport/utils": "workspace:*",
    "tslib": "^2.8.1"
  },
  "packageManager": "bun@1.3.1"
}

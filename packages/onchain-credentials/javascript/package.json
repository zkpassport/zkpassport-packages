{
  "name": "@zkpassport/onchain-credentials",
  "version": "0.1.0",
  "description": "Typed viem bindings for the ZKPassport onchain credential registry",
  "author": "ZKPassport",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zkpassport/zkpassport-packages",
    "directory": "packages/onchain-credentials/javascript"
  },
  "type": "module",
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev:build": "DEV_BUILD=true bun run build",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "check": "prettier -c src tests && eslint src tests --ext .ts",
    "format": "prettier -c -w src tests",
    "validate-package": "../../../scripts/validate-package.sh",
    "prepublishOnly": "../../../scripts/prepublish.sh"
  },
  "files": [
    "dist/esm",
    "dist/cjs"
  ],
  "keywords": [
    "zkpassport",
    "onchain credentials",
    "credentials",
    "viem",
    "ethereum"
  ],
  "dependencies": {
    "@zkpassport/utils": "workspace:*",
    "tslib": "^2.8.1",
    "viem": "^2.27.2"
  },
  "peerDependencies": {
    "@zkpassport/sdk": ">=0.17.0-beta.2"
  },
  "devDependencies": {
    "@zkpassport/sdk": "workspace:*"
  },
  "packageManager": "bun@1.3.1"
}

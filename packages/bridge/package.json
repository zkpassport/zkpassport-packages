{
  "name": "bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Bun/Node WebSocket bridge — a self-hosted, transparent relay for the Obsidion Bridge client.",
  "license": "Apache-2.0",
  "type": "module",
  "module": "server/index.ts",
  "scripts": {
    "start": "bun run server/index.ts",
    "dev": "bun --watch run server/index.ts",
    "test": "bun run test:real && bun run test:replay",
    "test:real": "USE_REAL_BRIDGE_SERVER=1 bun test --preload ./acceptance/setup.real.ts acceptance/tests/",
    "test:mock": "bun test acceptance/tests/",
    "test:replay": "bun test tests/replay.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/ciphers": "^1.2.1",
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^2.2.3",
    "@types/pako": "^2.0.3",
    "debug": "^4.3.4",
    "pako": "^2.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.2",
    "@types/debug": "^4.1.12",
    "@types/node": "^22.13.1",
    "@types/ws": "^8.5.10",
    "typescript": "^5.0.0"
  }
}

# Chain the demo runs against. Only ethereum_sepolia is supported.
NEXT_PUBLIC_CHAIN=ethereum_sepolia
# ZKPassportAttest registry deployment on that chain. Required.
NEXT_PUBLIC_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# Where the attest-popup app is served.
NEXT_PUBLIC_POPUP_URL=http://localhost:3000

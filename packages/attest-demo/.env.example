# Chain the demo runs against. Only ethereum_sepolia is supported.
NEXT_PUBLIC_CHAIN=ethereum_sepolia
# ZKPassportAttest registry deployment on that chain. Required.
NEXT_PUBLIC_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# Block the registry was deployed at; the policy list scans logs from here.
# Optional (defaults to 0, i.e. genesis — needs an RPC without a getLogs range cap).
# NEXT_PUBLIC_REGISTRY_DEPLOY_BLOCK=
# Where the attest-popup app is served.
NEXT_PUBLIC_POPUP_URL=http://localhost:3010
# Optional RPC override; defaults to the public sepolia endpoint the SDK ships with.
# Must allow eth_getLogs from block 0 (the policy list scans from genesis).
# NEXT_PUBLIC_RPC_URL=

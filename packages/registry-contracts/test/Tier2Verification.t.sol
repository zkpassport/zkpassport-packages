pragma solidity ^0.8.30;

import {Test} from "forge-std/Test.sol";
import {RootVerifier} from "../src/RootVerifier.sol";
import {RootRegistry} from "../src/RootRegistry.sol";
import {SubVerifier} from "../src/SubVerifier.sol";
import {VerifierHelper} from "../src/VerifierHelper.sol";
import {InputsExtractor} from "../src/lib/InputsExtractor.sol";
import {Credentials} from "../src/lib/Credentials.sol";
import {
    Environment,
    FaceMatchMode,
    ProofVerificationData,
    ProofVerificationParams,
    ProofVerifier,
    ServiceConfig
} from "../src/lib/Types.sol";
import {HonkVerifier} from "./fixtures/tier2/OuterAttestedIdCount2.sol";

// The fixture's synthetic attestation root key and app
bytes32 constant FIXTURE_ROOT_KEY_HASH = 0x2e9f2536abc888bfb1b65183015e2a8978884eaa515102e5473fe1f7d339fc1e;
bytes32 constant FIXTURE_APP_ID_HASH = 0x2b3bf722973f020cdf75a88acbf1ceef14e489f970b58378798d97453cb9a658;

/**
 * A Tier 2 outer EVM proof verified on chain, end to end: RootVerifier → SubVerifier → the
 * outer circuit's UltraHonk verifier. The fixture (test/fixtures/tier2) is a real proof of
 * outer_attested_id_count_2 over attested_id_ios_evm and disclose_bytes_evm, generated by the
 * circuits repo's src/ts/scripts/generate-tier2-evm-fixture.ts. Its attestation is synthetic: no
 * test can sign with Apple's root key, so the SubVerifier that accepts it swaps only the root
 * key and app checks for the fixture's; the production one must refuse it.
 */
contract Tier2VerificationTest is Test {
    bytes32 constant VERSION = bytes32("0.23.0");
    bytes32 constant VKEY_HASH = bytes32(uint256(0x7a2));
    uint256 constant ATTESTED_CAPTURE_IOS = 200;

    RootVerifier rootVerifier;
    RootVerifier testRootVerifier;
    bytes proof;
    bytes32[] publicInputs;
    bytes committedInputs;
    string domain;
    string scope;
    uint256 currentDate;

    function setUp() public {
        string memory dir = string.concat(vm.projectRoot(), "/test/fixtures/tier2/");
        proof = vm.parseBytes(string.concat("0x", vm.readFile(string.concat(dir, "proof.hex"))));
        publicInputs = vm.parseJsonBytes32Array(vm.readFile(string.concat(dir, "public_inputs.json")), "");
        committedInputs = vm.parseBytes(string.concat("0x", vm.readFile(string.concat(dir, "committed_inputs.hex"))));
        string memory attestation = vm.readFile(string.concat(dir, "attestation.json"));
        domain = vm.parseJsonString(attestation, ".domain");
        scope = vm.parseJsonString(attestation, ".scope");
        currentDate = vm.parseJsonUint(attestation, ".currentDate");
        assertEq(vm.parseJsonBytes32(attestation, ".rootKeyHash"), FIXTURE_ROOT_KEY_HASH);
        assertEq(vm.parseJsonBytes32(attestation, ".appIdHash"), FIXTURE_APP_ID_HASH);

        RootRegistry registry = RootRegistry(address(new AlwaysValidRootRegistry()));
        address verifier = address(new HonkVerifier());
        rootVerifier = _deploy(registry, verifier, false);
        testRootVerifier = _deploy(registry, verifier, true);
        vm.warp(currentDate);
    }

    function _deploy(RootRegistry registry, address verifier, bool acceptFixture) internal returns (RootVerifier root) {
        root = new RootVerifier(address(this), address(this), registry);
        SubVerifier sub = acceptFixture
            ? new FixtureAttestationSubVerifier(address(this), root)
            : new SubVerifier(address(this), root, bytes32(0));
        ProofVerifier[] memory verifiers = new ProofVerifier[](1);
        verifiers[0] = ProofVerifier({vkeyHash: VKEY_HASH, verifier: verifier});
        sub.addProofVerifiers(verifiers);
        root.addSubVerifier(VERSION, sub);
    }

    function _params(bytes memory proofBytes) internal view returns (ProofVerificationParams memory) {
        return ProofVerificationParams({
            version: VERSION,
            proofVerificationData: ProofVerificationData({
                vkeyHash: VKEY_HASH, proof: proofBytes, publicInputs: publicInputs
            }),
            committedInputs: committedInputs,
            serviceConfig: ServiceConfig({
                validityPeriodInSeconds: 1 days, domain: domain, scope: scope, devMode: false
            })
        });
    }

    function test_Tier2OuterProofVerifiesOnChain() public view {
        assertEq(uint256(publicInputs[publicInputs.length - 1]), ATTESTED_CAPTURE_IOS);
        (bool valid, bytes32 uniqueIdentifier, VerifierHelper helper) = testRootVerifier.verify(_params(proof));
        assertTrue(valid, "The Tier 2 outer proof should verify");
        assertEq(uniqueIdentifier, publicInputs[publicInputs.length - 3], "The scoped nullifier");
        assertEq(address(helper), address(0), "No helper is registered in this test");
    }

    function test_ProductionVerifierRefusesASelfSignedAttestation() public {
        vm.expectRevert("Invalid device attestation");
        rootVerifier.verify(_params(proof));
    }

    function test_OnlySignedAndAttestedSchemesVerify() public pure {
        assertTrue(Credentials.isVerifiable(100));
        assertTrue(Credentials.isVerifiable(200));
        assertTrue(Credentials.isVerifiable(201));
        assertFalse(Credentials.isVerifiable(0));
        assertFalse(Credentials.isVerifiable(300));
    }

    function test_AnotherScopeCannotPassTheFixture() public {
        // A proof made for one service's scope does not pass for another's
        ProofVerificationParams memory params = _params(proof);
        params.serviceConfig.scope = "another-service";
        vm.expectRevert("Invalid domain or scope");
        testRootVerifier.verify(params);
    }

    function test_ATamperedProofDoesNotVerify() public view {
        bytes memory tampered = proof;
        tampered[100] = bytes1(uint8(tampered[100]) ^ 1);
        // The UltraHonk verifier either reverts or returns false on a bad proof
        try testRootVerifier.verify(_params(tampered)) returns (bool valid, bytes32, VerifierHelper) {
            assertFalse(valid);
        } catch {}
    }
}

/// The production SubVerifier with the fixture's synthetic attestation root and app accepted
contract FixtureAttestationSubVerifier is SubVerifier {
    constructor(address admin, RootVerifier root) SubVerifier(admin, root, bytes32(0)) {}

    function _verifyDeviceAttestation(uint256 credentialScheme, bytes calldata committedInputs) internal pure override {
        if (credentialScheme != 200) return super._verifyDeviceAttestation(credentialScheme, committedInputs);
        (
            bytes32 rootKeyHash,
            Environment environment,
            bytes32 appIdHash,
            bytes32 integrityPublicKeyHash,
            FaceMatchMode mode
        ) = InputsExtractor.getAttestedIdProofInputs(committedInputs);
        require(
            rootKeyHash == FIXTURE_ROOT_KEY_HASH && appIdHash == FIXTURE_APP_ID_HASH
                && integrityPublicKeyHash == bytes32(0) && environment == Environment.PRODUCTION
                && mode == FaceMatchMode.STRICT,
            "Invalid device attestation"
        );
    }
}

contract AlwaysValidRootRegistry {
    function isRootValid(bytes32, bytes32, uint256) external pure returns (bool) {
        return true;
    }

    function isRootValidAtTimestamp(bytes32, bytes32, uint256) external pure returns (bool) {
        return true;
    }

    function latestRoot(bytes32) external pure returns (bytes32) {
        return bytes32(uint256(1));
    }
}

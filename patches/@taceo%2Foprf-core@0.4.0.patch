diff --git a/dist/index.cjs b/dist/index.cjs
index db614c058c7ab75c09d3c8fb3db4639833db874d..8914726a53c281a9c88ee35e15643a92c342a7d2 100644
--- a/dist/index.cjs
+++ b/dist/index.cjs
@@ -158,7 +158,10 @@ var import_modular2 = require("@noble/curves/abstract/modular.js");
 var import_utils = require("@noble/hashes/utils.js");
 var CURVE_N = import_misc2.babyjubjub.Point.CURVE().n;
 var COFACTOR = 8n;
-var SUBGROUP_SCALAR_ORDER = CURVE_N / COFACTOR;
+// @noble/curves 2.2.0 made CURVE().n the subgroup order (it was the curve order before), so dividing
+// by the cofactor gives a wrong scalar field and no blinding factor can be inverted. Pin the
+// subgroup order until @taceo/oprf-core ships the fix (oprf-client-js 7fee7d7, #54).
+var SUBGROUP_SCALAR_ORDER = CURVE_N % COFACTOR === 0n ? CURVE_N / COFACTOR : CURVE_N;
 var Fr = (0, import_modular2.Field)(SUBGROUP_SCALAR_ORDER, {
   BITS: 249
 });
